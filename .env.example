# ==========================================
# NSU RDS Automation - Environment Template
# ==========================================
# Copy this file to `.env` and fill in your actual credentials.
# `cp .env.example .env`

# 1. GitHub Authentication (PAT)
GITHUB_TOKEN=your_github_personal_access_token_here
GH_TOKEN=your_github_personal_access_token_here

# 2. RDS Portal Base URL
RDS_BASE_URL=http://10.102.11.254/rds_live_php84/
BASE_URL=http://10.102.11.254/rds_live_php84/

# 3. Student Credentials (Mahin)
MAHIN_STUDENT_ID=your_student_id
MAHIN_STUDENT_PASSWORD=your_password
MAHIN_STUDENT_NEW_PASSWORD=your_new_password

# 4. Student Credentials (Borshon)
BORSHON_STUDENT_ID=your_student_id
BORSHON_STUDENT_PASSWORD=your_password
SENIOR_STUDENT_ID=your_senior_student_id
SENIOR_STUDENT_PASSWORD=your_password
INCLUSION_STUDENT_ID=your_inclusion_student_id
INCLUSION_STUDENT_PASSWORD=your_password
UNLOCK_STUDENT_ID=your_unlock_student_id
UNLOCK_STUDENT_PASSWORD=your_password
TWOFA_STUDENT_ID=your_2fa_student_id
TWOFA_STUDENT_PASSWORD=your_password

# 5. Faculty Credentials
FACULTY_USERNAME=faculty_username
FACULTY_PASSWORD=faculty_password
