{
  "name": "nsu-rds-playwright-automation",
  "version": "1.0.0",
  "description": "Autonomous Playwright MCP and AI Agent Test Automation for NSU RDS",
  "scripts": {
    "test": "playwright test",
    "test:student": "playwright test tests/student/ --workers 1",
    "test:services": "playwright test tests/student/service/ --workers 1",
    "test:status": "playwright test tests/student/service/application-status.spec.ts",
    "test:profile": "playwright test tests/student/profile.spec.ts",
    "test:password": "playwright test tests/student/change-password.spec.ts",
    "test:password:headed": "playwright test tests/student/change-password.spec.ts --headed",
    "test:major": "playwright test tests/student/major-declaration.spec.ts",
    "test:major:headed": "playwright test tests/student/major-declaration.spec.ts --headed",
    "test:advising": "playwright test tests/student/course-advising.spec.ts",
    "test:advising:headed": "playwright test tests/student/course-advising.spec.ts --headed",
    "test:parking": "playwright test tests/student/service/car-parking.spec.ts",
    "test:exclusion": "playwright test tests/student/service/course-exclusion.spec.ts",
    "test:inclusion": "playwright test tests/student/service/course-inclusion.spec.ts",
    "test:credit-status": "playwright test tests/student/service/credit-status-update.spec.ts",
    "test:forgot-id": "playwright test tests/student/service/forgot-id.spec.ts",
    "test:unlock-id": "playwright test tests/student/service/id-unlock.spec.ts",
    "test:leave": "playwright test tests/student/service/leave.spec.ts",
    "test:drop": "playwright test tests/student/service/semester-drop.spec.ts",
    "test:waiver": "playwright test tests/student/service/waiver-course.spec.ts",
    "test:writing-center": "playwright test tests/student/service/writing-center.spec.ts",
    "test:faculty": "playwright test tests/faculty/exam-marks-entry.spec.ts",
    "map:portal": "playwright test tests/student/course-advising.spec.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright test && playwright show-report",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "nsu-rds",
    "antigravity",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
